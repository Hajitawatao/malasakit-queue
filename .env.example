APP_NAME="Malasakit Queueing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:88

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- XAMPP MySQL (MariaDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=malasakit_queue
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Kahit anong IP basta port 88 (para hindi na i-edit kapag nagpalit ng IP)
SANCTUM_STATEFUL_DOMAINS=*:88,localhost:88,127.0.0.1:88

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Kiosk key: ilagay sa kiosk URL  http://<IP>:88/kiosk?key=... ---
QUEUE_DEVICE_KEY=r1mc-a04ae334c68871c6

# --- Call Next ratio: 2 Fast : 1 Priority : 1 Regular ---
QUEUE_WEIGHT_FAST=2
QUEUE_WEIGHT_PRIORITY=1
QUEUE_WEIGHT_REGULAR=1

# --- Reverb (websocket para sa TV at counters) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=190125
REVERB_APP_KEY=f92043a44e7815116884
REVERB_APP_SECRET=78d7cc405621189336fbf074830a4ea4
# Saan kumokonekta ang Laravel para mag-push (sarili niyang PC)
REVERB_HOST=127.0.0.1
REVERB_PORT=6001
REVERB_SCHEME=http
# Saan nakikinig ang Reverb server
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# Naka-bake na sa compiled frontend (public/build). Kung papalitan ang key/port, kailangang i-rebuild.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_PORT}"
